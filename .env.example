# Server settings. npm start and npm run dev load an optional untracked .env.
# Copy this example to .env and uncomment only settings your environment needs.
PORT=4318
DATA_DIR=.local-data

# Optional CLI settings. These are separate from the server's provider settings.
PAPER_WORKBENCH_URL=http://127.0.0.1:4318
PAPER_WORKBENCH_TIMEOUT_MS=300000

# Supply an actual key only in an untracked runtime environment or secure stdin.
# PAPER_WORKBENCH_API_KEY=
# Configure provider/base URL/model through the sidebar or CLI config set.

# Optional external search for the question agent. Web access is off per question
# until enabled in the composer. No key: DuckDuckGo HTML (may return a CAPTCHA).
# With a Tavily key, Tavily is selected automatically unless overridden below.
# TAVILY_API_KEY=
# PAPER_WORKBENCH_SEARCH_PROVIDER=tavily

# Optional networking. Leave unset for normal direct networking.
# HTTP(S) proxy URLs are supported; do not commit proxy credentials.
# HTTPS_PROXY=http://127.0.0.1:8080
# HTTP_PROXY=http://127.0.0.1:8080
# ALL_PROXY=http://127.0.0.1:8080
# NO_PROXY=localhost,127.0.0.1,::1

# Optional DNS JSON resolver for networks that synthesize reserved/fake IPs.
# This sends queried source hostnames to the resolver you select.
# DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query
